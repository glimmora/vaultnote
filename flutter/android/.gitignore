# VaultNote Android .gitignore

# Keystore files (IMPORTANT: Never commit these)
keystore/
key.properties

# Build outputs
build/
**/build/

# Generated files
.gradle/
local.properties

# IntelliJ
*.iml
.idea/
*.ipr
*.iws

# Android Studio
.cxx/
*.hprof

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Keystore backup reminders
*.keystore.backup
*.jks.backup

# OS files
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.temp
